# ============================================================
# ThiagoMKT — Ecossistema de Automação
# Copie este arquivo para .env e preencha os valores
# Execute: bash scripts/setup.sh para gerar segredos automaticamente
# ============================================================

# === DOMÍNIO ===
DOMAIN=seudominio.com
# Para desenvolvimento local use: localhost

# ============================================================
# SUPABASE (banco de dados, auth, storage)
# Crie um projeto em https://supabase.com
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Connection string direto (para Drizzle ORM no backend)
DATABASE_URL=postgresql://postgres:[SUPABASE_DB_PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ============================================================
# REDIS (filas BullMQ, cache)
# ============================================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================================
# AUTENTICAÇÃO
# ============================================================
NEXTAUTH_SECRET=  # gerado por setup.sh
NEXTAUTH_URL=https://app.${DOMAIN}
# Para dev local: http://localhost:3000

# ============================================================
# CLAUDE AI (Anthropic)
# Obtenha em https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_DEFAULT_MODEL=claude-sonnet-4-6
AI_FAST_MODEL=claude-haiku-4-5-20251001
# Limite de gasto mensal em USD — sistema para quando atingido
AI_MAX_MONTHLY_BUDGET_USD=100

# ============================================================
# EVOLUTION API (Gateway WhatsApp)
# ============================================================
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=  # gerado por setup.sh
# Nome da instância WhatsApp pessoal (seu número)
EVOLUTION_MY_INSTANCE=thiago-personal
# Seu número no formato E.164 sem o + (ex: 5511999999999)
EVOLUTION_MY_PHONE=5511999999999
# Webhook que a Evolution chama quando chega mensagem
EVOLUTION_WEBHOOK_URL=https://api.${DOMAIN}/webhooks/evolution

# ============================================================
# N8N (orquestrador de workflows)
# ============================================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=  # gerado por setup.sh
N8N_ENCRYPTION_KEY=  # gerado por setup.sh
N8N_WEBHOOK_URL=https://n8n.${DOMAIN}/webhook
# URL interna para n8n chamar a API
N8N_API_URL=http://api:3001
N8N_API_INTERNAL_SECRET=  # gerado por setup.sh

# ============================================================
# TRAEFIK (reverse proxy)
# ============================================================
TRAEFIK_ACME_EMAIL=seu@email.com
# Dashboard do Traefik (desabilitar em produção: false)
TRAEFIK_DASHBOARD_ENABLED=true

# ============================================================
# API BACKEND
# ============================================================
API_PORT=3001
NODE_ENV=production
# Segredo para validar webhooks internos (n8n → api)
INTERNAL_WEBHOOK_SECRET=  # gerado por setup.sh

# ============================================================
# DASHBOARD NEXT.JS
# ============================================================
NEXT_PUBLIC_API_URL=https://api.${DOMAIN}
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
